# این فایل را کپی کنید به .env:
#   cp .env.example .env

# آدرسی که مرورگر برای تماس با بک‌اند استفاده می‌کند.
# اگر روی همون سیستم باز می‌کنید همین مقدار پیش‌فرض کافیست.
VITE_API_BASE_URL=http://localhost:8000

# باید با آدرس فرانت‌اند یکی باشد (برای اینکه مرورگر اجازه تماس بدهد)
CORS_ORIGINS=http://localhost:3000
