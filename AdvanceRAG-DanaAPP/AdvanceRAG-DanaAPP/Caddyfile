{$DOMAIN} {
	# API and its docs/streaming endpoints go straight to the backend
	# container; everything else is the built frontend served by nginx.
	handle /knowledge/* {
		reverse_proxy backend:8000
	}
	handle /chat/* {
		reverse_proxy backend:8000
	}
	handle /settings* {
		reverse_proxy backend:8000
	}
	handle /evaluation/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip
}
