# Copy to .env.prod and fill in before deploying with docker-compose.prod.yml

# Your domain, already pointed at this server's IP (A/AAAA record).
# Caddy will automatically get + renew a Let's Encrypt certificate for it.
DOMAIN=dana.example.com

# Must match the HTTPS origin the frontend is served from.
CORS_ORIGINS=https://dana.example.com

# Optional: default LLM/embedding provider for new users (each user can
# override these in the app's Settings page).
DEFAULT_LLM_BASE_URL=https://api.gapgpt.app/v1
DEFAULT_LLM_MODEL=gapgpt-qwen-3.6
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
