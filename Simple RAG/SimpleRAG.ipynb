   "source": [
    "import os\n",
    "import shutil\n",
    "\n",
    "from langchain_community.document_loaders import PyPDFLoader \n",
    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "from langchain_core.prompts import ChatPromptTemplate\n",
    "from langchain_core.runnables import RunnablePassthrough\n",
    "from langchain_core.output_parsers import StrOutputParser\n",
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_chroma import Chroma\n",
    "\n",
    "print(\"All imports loaded successfully! The foundation is ready.\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "de62c6f4-8501-48ef-8374-a862bc64ed39",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Step 1: Create Data Directory"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "acbde3fd-8151-4387-9ae0-0b8bc970a7ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a directory for storing PDF books\n",
    "os.makedirs(\"books\", exist_ok=True)\n",
    "\n",
    "print(\"Books directory created successfully!\")\n",
    "print(f\"Path: {os.path.abspath('books')}\")\n",
    "print(\"Please place your PDF books inside this folder.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0606a89f-f9b3-4467-8f03-a21667ee8995",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Step 2: Loading and Inspecting PDF Documents\n",
    "Load and inspect PDF documents to ensure data integrity before further processing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "98beeb1c-ef3c-4515-9837-7a8314cd2665",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the data directory\n",
    "data_dir = \"books\"\n",
    "\n",
    "# List all PDF files\n",
    "pdf_files = [f for f in os.listdir(data_dir) if f.endswith('.pdf')]\n",
    "\n",
    "if not pdf_files:\n",
    "    print(f\"No PDF files found in the '{data_dir}' directory.\")\n",
    "    print(f\"Path: {os.path.abspath(data_dir)}\")\n",
    "else:\n",
    "    print(f\"📚 Found {len(pdf_files)} PDF(s) to process.\\n\")\n",
    "    \n",
    "    all_documents = []\n",
    "    total_pages = 0\n",
    "    \n",
    "    for i, pdf_file in enumerate(pdf_files, 1):\n",
    "        # Using os.path.join for cross-platform compatibility\n",
    "        pdf_path = os.path.join(data_dir, pdf_file)\n",
    "        \n",
    "        print(f\" [{i}/{len(pdf_files)}] Loading: {pdf_file}\")\n",
    "        \n",
    "        # Load PDF\n",
    "        loader = PyPDFLoader(pdf_path)\n",
    "        docs = loader.load()\n",
    "        \n",
    "        all_documents.extend(docs)\n",
    "        total_pages += len(docs)\n",
    "        \n",
    "        # Preview the content\n",
    "        preview = docs[0].page_content[:120].replace('\\n', ' ').strip()\n",
    "        print(f\"     Pages: {len(docs)}\")\n",
    "        print(f\"     Preview: {preview}...\")\n",
    "        print(\"-\" * 30)\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(f\"   Processing Complete!\")\n",
    "    print(f\"   Total Books: {len(pdf_files)}\")\n",
    "    print(f\"   Total Pages: {total_pages}\")\n",
    "    print(f\"    Status: Ready for the next step.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "81266bb0-eb73-4efa-8cd8-5e5ab02ad594",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "## Data Validation & Preview\n",
    "Validate the loaded documents and preview their content and metadata to ensure data integrity before further processing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "11c7fba1-d44d-4179-abfd-af5e5b6cebe5",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"Total documents loaded: {len(all_documents)}\")\n",
    "\n",
    "print(f\"\\nPreview of the first 3 pages:\")\n",
    "\n",
    "for i, doc in enumerate(all_documents[:3], 1):\n",
    "    # Truncate content for cleaner preview\n",
    "    text = doc.page_content[:200].replace('\\n', ' ')\n",
    "    \n",
    "    # Get metadata safely\n",
    "    source = os.path.basename(doc.metadata.get('source', 'Unknown'))\n",
    "    page = doc.metadata.get('page', 'N/A')\n",
    "    \n",
    "    print(f\"\\n--- Page {page} from {source} ---\")\n",
    "    print(f\" {text}...\")\n",
    "\n",
    "print(f\"\\n{'='*50}\\n Data validation complete. Ready for the next stage!\")\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8273fb8d-59aa-4137-8b65-198662b11a9f",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "    \n",
    "# Step 3: Text Splitting & Chunking\n",
    "\n",
    "To make large PDF documents searchable by an LLM, we break them into smaller, manageable chunks. We use `RecursiveCharacterTextSplitter` to preserve semantic meaning while keeping chunks within token limits.\n",
    "\n",
    "- **Chunk Size :** 1000 characters — balances contextual information and retrieval precision.  \n",
    "- **Chunk Overlap :** 200 characters — maintains context continuity between chunks.  \n",
    "- **Expansion Factor :** Calculated as `Total Chunks / Total Documents`.\n",
    "\n",
    "  - **Result :** ~1.9 (Balanced)  \n",
    "  - **Purpose :** Ensures text segments are neither too large nor over-fragmented, improving retrieval performance.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "060f09e6-ef37-4baf-a665-3eab2a4e220a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize the text splitter\n",
    "text_splitter = RecursiveCharacterTextSplitter(\n",
    "    chunk_size=1000,         # Max characters per chunk\n",
    "    chunk_overlap=200,       # 200 characters overlap\n",
    "    length_function=len,     # Length function: character count\n",
    "    separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"]  # Order of separators\n",
    ")\n",
    "\n",
    "# Split all documents\n",
    "splitted_documents = text_splitter.split_documents(all_documents)\n",
    "\n",
    "print(f\"Chunks are ready!\")\n",
    "print(f\"Original documents: {len(all_documents)}\")\n",
    "print(f\"New chunks: {len(splitted_documents)}\")\n",
    "print(f\"Expansion factor: {len(splitted_documents)/len(all_documents):.1f}x\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b7333a67-297a-42d7-bb70-47f644d7cc31",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "## Chunk Validation & Sanity Check\n",
    "Performing a quick sanity check allows us to inspect the content structure and metadata integrity of the chunks before we proceed to the embedding stage."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d4ee897f-21f0-44a3-8f9b-dacd81ae87bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i, chunk in enumerate(splitted_documents[:3]):\n",
    "    print(f\"Chunk {i+1}:\")\n",
    "    print(f\"Source: {chunk.metadata['source']}\")\n",
    "    print(f\"Length: {len(chunk.page_content)} characters\")\n",
    "    print(f\"Preview: {chunk.page_content[:150]}...\")\n",
    "    print(\"-\" * 50)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1cdb7b6b-e641-4720-accc-b525783745e6",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Step 4: Embedding Generation\n",
    "\n",
    "We initialize a pre-trained sentence-transformer model to convert our text chunks into high-dimensional vector representations. \n",
    "\n",
    "- **Model :** `all-MiniLM-L6-v2` (Lightweight and efficient).\n",
    "- **Normalization :** Enabled, to optimize cosine similarity calculations.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44afacf7-065c-4226-a21e-92fdeb9c2ae5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define model configuration registry\n",
    "# This approach is much more robust than string-matching names\n",
    "MODEL_CAPABILITIES = {\n",
    "    \"sentence-transformers/all-MiniLM-L6-v2\": \"Multilingual (Supports Persian and 100+ languages)\",\n",
    "    \"sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2\": \"Multilingual (Optimized for cross-lingual tasks)\",\n",
    "    \"sentence-transformers/all-mpnet-base-v2\": \"English-optimized (Monolingual)\"\n",
    "}\n",
    "\n",
    "model_id = \"sentence-transformers/all-MiniLM-L6-v2\"\n",
    "\n",
    "# Initialize the embedding model\n",
    "embedding_model = HuggingFaceEmbeddings(\n",
    "    model_name=model_id,\n",
    "    model_kwargs={'device': 'cpu'},\n",
    "    encode_kwargs={'normalize_embeddings': True}\n",
    ")\n",
    "\n",
    "# Look up language status in our registry\n",
    "# Use .get() with a default value for unknown models\n",
    "language_status = MODEL_CAPABILITIES.get(model_id, \"General purpose embedding model\")\n",
    "\n",
    "# Compute the embedding dimension\n",
    "sample_text = \"test\"\n",
    "dims = len(embedding_model.embed_query(sample_text))\n",
    "\n",
    "# Display model information\n",
    "print(f\"Embedding model initialized: {model_id}\")\n",
    "print(f\"Dimensions: {dims}-dimensional\")\n",
    "print(f\"Language Support: {language_status}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7c11c9b5-8d1b-47bf-bcf0-fc9598a6a459",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Step 5: Building and Persisting the Vector Store\n",
    "We generate embeddings for all chunks and store them in a persistent Chroma vector database to enable efficient similarity search.\n",
    "As part of the validation process, we verify that the number of stored vectors matches the number of generated chunks (Number of Stored Vectors = Number of Chunks). This equality ensures the integrity of the indexing pipeline and confirms that no chunk was missed or duplicated during ingestion.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2f61f77e-ded1-4d42-a671-bc657a8cc48b",
   "metadata": {},
   "outputs": [],
   "source": [
    "persist_directory = \"chroma_db\"\n",
    "\n",
    "print(\"Building the vector store...\")\n",
    "print(f\"Total chunks to index: {len(splitted_documents)}\")\n",
    "\n",
    "# 1. Clean up: For development cycles, removing old db ensures a fresh, consistent state\n",
    "if os.path.exists(persist_directory):\n",
    "    shutil.rmtree(persist_directory)\n",
    "    print(\"Previous vector database cleared.\")\n",
    "\n",
    "# 2. Create the vector store\n",
    "# Note: ChromaDB 0.4+ performs auto-persistence, so .persist() is no longer needed\n",
    "vector_store = Chroma.from_documents(\n",
    "    documents=splitted_documents,\n",
    "    embedding=embedding_model,\n",
    "    persist_directory=persist_directory,\n",
    "    collection_name=\"my_books\"\n",
    ")\n",
    "\n",
    "# 3. Validation: Display status\n",
    "# We access _collection.count() for diagnostic purposes to ensure data integrity\n",
    "record_count = vector_store._collection.count()\n",
    "\n",
    "print(\"Vector store created successfully!\")\n",
    "print(f\"Location: {os.path.abspath(persist_directory)}\")\n",
    "print(f\"Records stored: {record_count}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "03ad2a7e-7d3d-4326-880c-35aa4c52d6bf",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "## Similarity Search & Validation\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a4dcc6f-b0f3-43f9-8fc7-d39178bf720d",
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"What are large language models?\"\n",
    "results = vector_store.similarity_search_with_score(query, k=5)\n",
    "\n",
    "for i, (doc, score) in enumerate(results, start=1):\n",
    "    print(f\"\\nResult {i} | Score: {score:.4f} | Page: {doc.metadata.get('page')}\")\n",
    "    print(f\"Source: {doc.metadata.get('source')}\")\n",
    "    print(f\"Preview: {doc.page_content[:120]}...\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f1521e1e-7446-447f-8cc5-603d8fffecfa",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "## Loading the Persisted Vector Store\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "35084d64-b9a9-41a1-a799-d03e99618bd4",
   "metadata": {},
   "outputs": [],
   "source": [
    "PERSIST_DIRECTORY = \"chroma_db\"\n",
    "COLLECTION_NAME = \"my_books\"\n",
    "\n",
    "def load_vector_store(embedding_model):\n",
    "    \"\"\"\n",
    "    Load an existing Chroma vector store from disk.\n",
    "    \"\"\"\n",
    "\n",
    "    if not os.path.exists(PERSIST_DIRECTORY):\n",
    "        raise FileNotFoundError(\n",
    "            \"Vector store directory not found. Please build it first.\"\n",
    "        )\n",
    "\n",
    "    vector_store = Chroma(\n",
    "        persist_directory=PERSIST_DIRECTORY,\n",
    "        embedding_function=embedding_model,\n",
    "        collection_name=COLLECTION_NAME\n",
    "    )\n",
    "\n",
    "    print(\"Vector store loaded successfully!\")\n",
    "\n",
    "    return vector_store\n",
    "\n",
    "\n",
    "# Load the persisted vector store\n",
    "vector_store = load_vector_store(embedding_model)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ee47917b-97e8-4a1d-8396-fa6f88ba75df",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "\n",
    "# Step 6: Configuring the Retriever\n",
    "\n",
    "The retriever is the bridge between our knowledge base and the Language Model. In this step, we convert the vector store into a retriever interface, which is responsible for fetching the most relevant document chunks based on **semantic similarity**.\n",
    "By standardizing this interface, we ensure that our retrieval process is optimized for integration into the final RAG pipeline, allowing the model to generate grounded and context-aware responses.\n",
    "ty.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "825e95b1-57a2-4209-9d81-41378ec3dbb5",
   "metadata": {},
   "outputs": [],
   "source": [
    "retriever = vector_store.as_retriever(\n",
    "    search_type=\"similarity\",\n",
    "    search_kwargs={\n",
    "        \"k\": 4\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"Retriever successfully configured\")\n",
    "print(f\"- Search Type: similarity (cosine-based semantic search)\")\n",
    "print(f\"- Top-K Results: {retriever.search_kwargs['k']}\")\n",
    "print(f\"- Embedding Model: {type(embedding_model).__name__}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "04ccd86c-10e8-4a32-b836-1bfac53098f6",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Testing the Retriever with Sample Queries\n",
    "To validate the effectiveness of our configured retriever, we will now test it with a sample query. This step helps us verify that the retriever can indeed fetch the most relevant document chunks from the vector store based on semantic similarity."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dd186eb6-da11-4fc9-b391-d4562bbb316e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define a sample query\n",
    "test_q = \"What is LLM?\"\n",
    "\n",
    "# Use the retriever to find relevant documents\n",
    "docs = retriever.invoke(test_q)\n",
    "\n",
    "print(f\"--- Testing Retriever ---\")\n",
    "print(f\"❓ Query: '{test_q}'\\n\")\n",
    "\n",
    "if docs:\n",
    "    for i, doc in enumerate(docs, 1):\n",
    "        # Consolidated metadata extraction and formatting\n",
    "        source = doc.metadata.get('source', 'Unknown Source')\n",
    "        page = doc.metadata.get('page', 'N/A')\n",
    "        score = doc.metadata.get('score', None) # Assuming score is available\n",
    "        score_display = f\" | Score: {score:.4f}\" if score is not None else \"\"\n",
    "\n",
    "        text_preview = doc.page_content[:120].replace('\\n', ' ')\n",
    "\n",
    "        # Consolidated print statement for result details\n",
    "        print(f\" Result {i}: [Source: {source} | Page: {page}{score_display}]\")\n",
    "        print(f\" Content Preview: {text_preview}...\\n\")\n",
    "else:\n",
    "    print(\"No relevant documents found for this query.\")\n",
    "\n",
    "print(f\"--- End of Retriever Test ---\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "39ab5d43-56c5-4ab2-8af2-7263a8deacd9",
   "metadata": {},
   "source": [
    "<div style=\"border:1px solid #d0d7de; padding:16px; border-radius:8px;\">\n",
    "\n",
    "# Step 7: Generating the Final Response with LLM\n",
    "We execute the **RAG Chain** to process the user's query. The chain uses the **Retriever** to fetch relevant data, formats it, and sends it to the **LLM**. The LLM then synthesizes this context into a coherent, human-like answer. The final output is displayed clearly, including `source` and `page` info for validation.\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6e837f8a-bbdd-4b4e-8c79-177cbfd76221",
   "metadata": {},
   "outputs": [],
   "source": [
    "llm = ChatOpenAI(\n",
    "    model=\"gpt-4o-mini\", \n",
    "    temperature=0.2, \n",
    "    api_key=\"your API key", \n",
    "    base_url=\"https://api.gapgpt.app/v1\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd46f22e-ed99-4207-874a-7017b5823e8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prompt Definition\n",
    "template = \"\"\"You are a precise and knowledgeable AI assistant.\n",
    "Answer the question using only the provided context. If the answer is not found in the context, state that you couldn't find the information.\n",
    "\n",
    "Context:\n",
    "{context}\n",
    "\n",
    "User Question: {question}\n",
    "\n",
    "Answer:\"\"\"\n",
    "\n",
    "prompt = ChatPromptTemplate.from_template(template)\n",
    "\n",
    "# Context Formatting Function \n",
    "def format_docs(docs):\n",
    "    \"\"\"\n",
    "    Formats a list of Document objects into a single string.\n",
    "\n",
    "    Args:\n",
    "        docs (list): A list of Document objects, typically retrieved from a vector store.\n",
    "\n",
    "    Returns:\n",
    "        str: A formatted string representing the concatenated documents with metadata.\n",
    "    \"\"\"\n",
    "    parts = []\n",
    "    for i, doc in enumerate(docs, 1):\n",
    "        src = doc.metadata.get('source', 'Unknown Source')\n",
    "        pg = doc.metadata.get('page', '?') # Use '?' as placeholder if page is missing\n",
    "        parts.append(f\"[{i}] {src} (Page {pg})\\n{doc.page_content}\")\n",
    "\n",
    "    # Join all formatted document parts with a clear separator\n",
    "    return \"\\n\\n---\\n\".join(parts)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdab473f-b75c-4d6e-87ea-fc3023e0c99e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RAG Chain Definition \n",
    "\n",
    "rag_chain = (\n",
    "    {\n",
    "        \"context\": retriever | format_docs,\n",
    "        \"question\": RunnablePassthrough()\n",
    "    }\n",
    "    | prompt\n",
    "    | llm\n",
    "    | StrOutputParser()\n",
    ")\n",
    "\n",
    "print(\"Chain successfully constructed!\")\n"
   ]
  },
